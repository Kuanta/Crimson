{
    "configurations": [
        {
            "name":"cpp-dev",
            "configurationProvider": "ms-vscode.cmake-tools",
            "defines":["CRIMSON_EXPORT", "CRIMSON_ENABLE_LOG"],
            "macFrameworkPath": [
                "/System/Library/Frameworks",
                "/Library/Frameworks"
            ],
            "intelliSenseMode": "${default}",
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c17",
            "cppStandard": "c++17"
        }
    ],
    "version": 4
}