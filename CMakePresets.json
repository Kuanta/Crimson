{
    "version": 3,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 21,
      "patch": 0
    },
    "configurePresets": [
      {
        "name": "debug",
        "displayName": "Debug",
        "description": "Configure Debug build with Conan toolchain",
        "generator": "Ninja", 
        "binaryDir": "${sourceDir}/build/Debug",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug",
          "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/Debug/conan_toolchain.cmake"
        }
      },
      {
        "name": "release",
        "displayName": "Release",
        "description": "Configure Release build with Conan toolchain",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/Release",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release",
          "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/Release/conan_toolchain.cmake"
        }
      }
    ],
    "buildPresets": [
      {
        "name": "debug",
        "configurePreset": "debug"
      },
      {
        "name": "release",
        "configurePreset": "release"
      }
    ]
  }
  